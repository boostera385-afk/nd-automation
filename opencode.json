{
  "$schema": "https://opencode.ai/config.json",
  "watcher": { "ignore": ["**/node_modules/**", "**/.next/**", "**/coverage/**", "**/.venv/**", "screenshots/**", "temp_images/**"] },
  "permissions": [
    { "action": "playwright_browser_run_code_unsafe", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "supabase_apply_migration", "resource": "*", "effect": "ask" },
    { "action": "supabase_execute_sql", "resource": "*", "effect": "ask" }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx.cmd",
          "-y",
          "@playwright/mcp@0.0.83",
          "--headless",
          "--isolated",
          "--no-webmcp",
          "--image-responses",
          "omit",
          "--allowed-origins",
          "http://localhost:*;http://127.0.0.1:*"
        ],
        "timeout": { "startup": 120000 }
      },
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=xtefjnfdjnxwrpkoydaj&features=database,docs,development,debugging"
      }
    }
  }
}
