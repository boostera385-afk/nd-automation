{
  "name": "nd-reporting-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bundle:connector": "node scripts/bundle-sheet-connector.mjs",
    "predev": "npm run bundle:connector",
    "prebuild": "npm run bundle:connector",
    "check:readiness": "node --experimental-strip-types scripts/check-readiness.ts",
    "check:deployment": "node --experimental-strip-types scripts/check-deployment.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.95.0",
    "csv-parse": "^7.0.3",
    "lucide-react": "^0.577.0",
    "next": "^16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
