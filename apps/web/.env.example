# Copy to .env.local. Never commit .env.local or a service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Optional read-only sheet sync (see integrations/sheets/README.md). Server-side only: never prefix with NEXT_PUBLIC_.
SHEET_SYNC_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
SHEET_SYNC_TOKEN=

# Trusted canonical application URL for email redirects. Set your HTTPS domain in production.
APP_URL=http://localhost:3000
